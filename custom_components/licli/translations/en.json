          "http": "HTTP (licli serve)",
          "local": "Local CLI (liauto)"
        }
      },
      "http": {
        "title": "HTTP server",
        "description": "Point to a running `licli serve` instance.",
        "data": {
          "host": "Server address",
          "token": "Token"
        }
      },
      "local": {
        "title": "Activation code",
        "description": "licli requires an activation code (LICLI_CODE) for vehicle status and control.",
        "data": {
          "activation_code": "Activation code"
        }
      },
      "local_action": {
        "title": "Local CLI",
        "description": "Reuse existing credentials in .storage/licli, or re-authorize.",
        "menu_options": {
          "local_reuse": "Reuse existing config",
          "local_reauth": "Re-authorize"
        }
      },
      "local_reauth": {
        "title": "Authorize",
        "description": "Open the following URL and log in with your Li Auto account:\n\n{auth_url}\n\nThen press Submit to continue.",
        "data": {
          "confirm": "I have logged in"
        }
      },
      "local_token": {
        "title": "Token",
        "description": "Paste the token JSON returned after login.",
        "data": {
          "token_json": "Token JSON"
        }
      },
      "reconfigure_local": {
        "title": "Reconfigure: activation code",
        "description": "Update the activation code. It is validated against the existing credentials.",
        "data": {
          "activation_code": "Activation code"
        }
      },
      "reconfigure_http": {
        "title": "Reconfigure: HTTP server",
        "description": "Update the HTTP server address and token.",
        "data": {
          "host": "Server address",
          "token": "Token"
        }
      }
    },
    "error": {
      "code_required": "Activation code is required",
      "invalid_code": "Invalid activation code",
      "cannot_connect": "Cannot connect to the licli server",
      "no_vehicles": "No vehicles found",
      "cannot_reuse": "Could not reuse existing config",
      "no_vehicles_reuse": "No vehicles with existing config",
      "login_start_failed": "Failed to start login",
      "token_invalid": "Invalid token"
    },
    "abort": {
      "reconfigure_successful": "Reconfiguration successful"
