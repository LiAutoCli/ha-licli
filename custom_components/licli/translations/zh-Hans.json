  "config": {
    "step": {
      "mode": {
        "title": "连接模式",
        "description": "Home Assistant 如何连接 licli？",
        "menu_options": {
          "http": "HTTP (licli serve)",
          "local": "本地 CLI (liauto)"
        }
      },
      "http": {
        "title": "HTTP 服务器",
        "description": "指向正在运行的 `licli serve` 实例。",
        "data": {
          "host": "服务器地址",
          "token": "令牌"
        }
      },
      "local": {
        "title": "激活码",
        "description": "licli 查询车辆状态和控制需要激活码（LICLI_CODE）。",
        "data": {
          "activation_code": "激活码"
        }
      },
      "local_action": {
        "title": "本地 CLI",
        "description": "使用 .storage/licli 中的现有凭据，或重新授权。",
        "menu_options": {
          "local_reuse": "复用已有配置",
          "local_reauth": "重新授权"
        }
      },
      "local_reauth": {
        "title": "授权",
        "description": "打开以下 URL 并使用理想汽车账号登录：\n\n{auth_url}\n\n然后点击提交继续。",
        "data": {
          "confirm": "我已登录"
        }
      },
      "local_token": {
        "title": "Token",
        "description": "粘贴登录后返回的 Token JSON。",
        "data": {
          "token_json": "Token JSON"
        }
      },
      "reconfigure_local": {
        "title": "重新配置：激活码",
        "description": "更新激活码，会基于现有凭据进行校验。",
        "data": {
          "activation_code": "激活码"
        }
      },
      "reconfigure_http": {
        "title": "重新配置：HTTP 服务器",
        "description": "更新 HTTP 服务器地址和 Token。",
        "data": {
          "host": "服务器地址",
          "token": "令牌"
        }
      }
    },
    "error": {
      "code_required": "请填写激活码",
